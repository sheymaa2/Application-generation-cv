# Copiez ce fichier en ".env" et remplissez vos vraies valeurs.
# Sans .env, l'application marche quand même : le lien de validation s'affiche à l'écran.
#
# Pour tester sans envoyer de vrais emails : compte gratuit sur https://mailtrap.io (Email Sandbox)

SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=votre_identifiant_mailtrap
SMTP_PASS=votre_mot_de_passe_mailtrap
SMTP_FROM=noreply@example.com
